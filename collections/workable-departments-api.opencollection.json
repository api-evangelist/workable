{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workable Accounts Departments API",
    "version": "3.21.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Departments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List departments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.workable.com/spi/v3/departments"
          },
          "docs": "List departments"
        },
        {
          "info": {
            "name": "Create department",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.workable.com/spi/v3/departments"
          },
          "docs": "Create department"
        },
        {
          "info": {
            "name": "Update department",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{subdomain}.workable.com/spi/v3/departments"
          },
          "docs": "Update department"
        },
        {
          "info": {
            "name": "Delete department",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{subdomain}.workable.com/spi/v3/departments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete department"
        },
        {
          "info": {
            "name": "Merge departments",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.workable.com/spi/v3/departments/:id/merge",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Merge departments"
        }
      ]
    }
  ],
  "bundled": true
}