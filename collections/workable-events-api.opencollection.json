{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workable Accounts Events API",
    "version": "3.21.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.workable.com/spi/v3/events"
          },
          "docs": "List events"
        },
        {
          "info": {
            "name": "Get event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.workable.com/spi/v3/events/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get event"
        }
      ]
    }
  ],
  "bundled": true
}